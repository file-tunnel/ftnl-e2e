{
  "name": "ftnl-e2e",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:browser",
    "test:browser": "npm run typecheck && npm run test:playwright && npm run test:puppeteer && npm run test:selenium",
    "test:list": "playwright test --list && node scripts/check-suite-layout.mjs",
    "test:desktop": "node --test tests/desktop/desktop-parity.e2e.test.mjs",
    "test:playwright": "node scripts/with-services.mjs playwright",
    "test:playwright:runner": "playwright test",
    "test:puppeteer": "node scripts/with-services.mjs puppeteer",
    "test:puppeteer:runner": "tsx --test --test-concurrency=1 tests/browser/puppeteer/*.test.ts",
    "test:selenium": "node scripts/with-services.mjs selenium",
    "test:selenium:runner": "tsx --test --test-concurrency=1 tests/browser/selenium/*.test.ts",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.0",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/ws": "^8.18.1",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "puppeteer": "^25.9.0",
    "qrcode": "^1.5.4",
    "selenium-webdriver": "^4.48.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
